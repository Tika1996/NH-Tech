rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================
    
    // Vérifie si l'utilisateur est authentifié
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Récupère le document staff de l'utilisateur connecté
    function getStaffData() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }
    
    // Vérifie si l'utilisateur a un rôle spécifique
    function hasRole(role) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
             getStaffData().role == role;
    }
    
    // Vérifie si l'utilisateur est admin
    function isAdmin() {
      return hasRole('admin');
    }
    
    // Vérifie si l'utilisateur est manager ou admin
    function isManagerOrAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
             getStaffData().role in ['admin', 'manager'];
    }
    
    // Vérifie si le compte utilisateur est actif
    function isActive() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
             getStaffData().isActive == true;
    }
    
    // ============================================================
    // STAFF COLLECTION
    // ============================================================
    match /staff/{staffId} {
      allow read, write: if isAuthenticated();
    }
    
    // ============================================================
    // SERVICES COLLECTION
    // ============================================================
    match /services/{serviceId} {
      allow read, write: if isAuthenticated();
    }
    
    // ============================================================
    // PRODUCTS COLLECTION
    // ============================================================
    match /products/{productId} {
      allow read, write: if isAuthenticated();
    }
    
    // ============================================================
    // CUSTOMERS COLLECTION
    // ============================================================
    match /customers/{customerId} {
      allow read, write: if isAuthenticated();
    }
    
    // ============================================================
    // RESERVATIONS COLLECTION
    // ============================================================
    match /reservations/{reservationId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }
    
    // ============================================================
    // INSCRIPTIONS COLLECTION
    // ============================================================
    match /inscriptions/{inscriptionId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }
    
    // ============================================================
    // TRANSACTIONS COLLECTION (POS)
    // ============================================================
    match /transactions/{transactionId} {
      allow read, write: if isAuthenticated();
    }
    
    // ============================================================
    // STOCK MOVEMENTS COLLECTION
    // ============================================================
    match /stockMovements/{movementId} {
      allow read, write: if isAuthenticated();
    }
    
    // ============================================================
    // CASH SESSIONS COLLECTION
    // ============================================================
    match /cashSessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }
    
    // ============================================================
    // SETTINGS COLLECTION
    // ============================================================
    match /settings/{settingId} {
      allow read, write: if isAuthenticated();
    }
    
    // ============================================================
    // Z REPORTS COLLECTION
    // ============================================================
    match /zReports/{reportId} {
      allow read, write: if isAuthenticated();
    }
    
    // ============================================================
    // DEFAULT DENY
    // ============================================================
    // Toute autre collection non listée : autoriser si authentifié
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
